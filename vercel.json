{
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "permanent": true
    },
    {
      "source": "/landing-old",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/learn",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/learn/:slug",
      "destination": "/blog/:slug",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/((?!api/.*).*)", "destination": "/index.html" }
  ]
}
